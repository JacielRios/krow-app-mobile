SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Android Emulator: http://10.0.2.2:3000
KROW_API_URL=http://10.0.2.2:3000
KROW_PILOT_ENABLED=false
KROW_TRACKING_ENABLED=false
KROW_PILOT_PUSH_ENABLED=false
KROW_ACCOUNT_CLOSURE_ENABLED=false
KROW_SUPPORT_URL=
KROW_PRIVACY_URL=
# HTTPS app link also authorized in Supabase Auth redirect allowlist.
# Use the same host as the native KROW_LINK_ORIGIN, with path /auth.
KROW_AUTH_REDIRECT_URL=
KROW_IOS_MAPS_API_KEY=your-ios-google-maps-key
# El mapa Android usa KROW_ANDROID_MAPS_API_KEY como variable del entorno de
# compilación o en android/local.properties (no aquí). Debe ser distinta de la clave REST del backend y estar
# restringida por package name com.krownmobileapp + SHA de firma.
# Solo debug admite la antigua GOOGLE_MAPS_API_KEY del .env móvil como alternativa.
# Release exige KROW_ANDROID_MAPS_API_KEY y nunca usa esa alternativa.
# Enable only after the backend migration and native release gates pass.
KROW_RUNTIME_ENABLED=false
KROW_MAPBOX_PUBLIC_TOKEN=
KROW_LINK_ORIGIN=
# Native Android build environment (public Firebase app configuration, never server credentials):
# KROW_FIREBASE_APP_ID, KROW_FIREBASE_API_KEY, KROW_FIREBASE_PROJECT_ID,
# KROW_FIREBASE_SENDER_ID, KROW_LINK_ORIGIN.
# iOS signing/build settings: KROW_LINK_ORIGIN, Associated Domains and Push Notifications.
